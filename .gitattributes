# Normalize line endings to LF on commit, check out as native (LF on Linux, CRLF on Windows)
* text=auto

# Force LF for source files — Dev Containers run Linux
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf
